    "credentials_file": "private/agent.json",
    "ca_cert_file": "public/ca.crt",
    "disk": ".",
    "queue_dir": "",
    "interval": "5s",
    "count": 0,
    "max_queue_mb": 64,
    "request_timeout": "5s",
    "heartbeat_interval": "15s"
  },
  "receiver": {
