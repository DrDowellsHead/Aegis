# Non-secret Compose parameters only. Do not put passwords or tokens here.
AEGIS_IMAGE_TAG=dev
# gRPC is intentionally published; restrict source IPs with the VPS firewall.
AEGIS_GRPC_BIND_IP=0.0.0.0
AEGIS_GRPC_PORT=9090
# HTTPS dashboard is deliberately HOST-LOOPBACK only by default.
AEGIS_DASHBOARD_BIND_IP=127.0.0.1
AEGIS_DASHBOARD_PORT=8443
AEGIS_DASHBOARD_ORIGIN=https://localhost:8443
# Optional notification profile. Never put a Telegram bot token in .env.
AEGIS_TELEGRAM_CHAT_ID=
