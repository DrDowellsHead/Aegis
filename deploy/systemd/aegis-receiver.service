[Unit]
Description=Aegis authenticated telemetry receiver
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=simple
User=aegis
Group=aegis
Environment=AEGIS_DATABASE_URL_FILE=/etc/aegis/private/database.url
ExecStart=/usr/local/bin/aegis start --config /etc/aegis/receiver.json --component receiver
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
StateDirectory=aegis
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/aegis
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
