[Unit]
Description=Aegis telemetry agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=aegis
Group=aegis
ExecStart=/usr/local/bin/aegis start --config /etc/aegis/agent.json --component agent
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
StateDirectory=aegis
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/aegis
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
