<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.aegis.agent</string>
    <key>UserName</key><string>aegis</string>
    <key>GroupName</key><string>aegis</string>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key>
    <dict><key>SuccessfulExit</key><false/></dict>
    <key>ThrottleInterval</key><integer>15</integer>
    <key>WorkingDirectory</key><string>/var/db/aegis</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/aegis</string>
        <string>start</string>
        <string>--config</string>
        <string>/usr/local/etc/aegis/agent.json</string>
        <string>--component</string>
        <string>agent</string>
    </array>
    
</dict>
</plist>
